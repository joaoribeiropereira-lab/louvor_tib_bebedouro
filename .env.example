# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis na Vercel.
# Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# SECRETA: nunca use o prefixo NEXT_PUBLIC_ e nunca envie ao GitHub.
# Usada somente no servidor, para convidar e bloquear usuários.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
